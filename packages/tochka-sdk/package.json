{
  "name": "@onreza/tochka-sdk",
  "version": "0.5.1",
  "description": "Типизированный TypeScript SDK для API Точка Банка",
  "type": "module",
  "license": "MIT",
  "author": "ONREZA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONREZA/tochka-sdk-ts.git",
    "directory": "packages/tochka-sdk"
  },
  "keywords": [
    "tochka",
    "tochka-bank",
    "sbp",
    "open-banking",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./pay-gateway": {
      "types": "./dist/pay-gateway.d.ts",
      "default": "./dist/pay-gateway.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun --bun run tsdown",
    "dev": "bun --bun run tsdown --watch",
    "prepack": "bun ../../tools/package-files.ts prepare && bun run build",
    "postpack": "bun ../../tools/package-files.ts clean",
    "test": "bun test --parallel test/unit",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --stableTypeOrdering --checkers 1",
    "typecheck:portable": "node node_modules/@typescript/native/bin/tsc --noEmit --stableTypeOrdering --checkers 1 -p tsconfig.portable.json",
    "test:integration": "bun test test/sandbox"
  },
  "dependencies": {
    "jose": "6.2.14",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/bun": "catalog:",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}

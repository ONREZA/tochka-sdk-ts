{
  "name": "@onreza/tochka-sdk",
  "version": "0.2.1",
  "description": "Типизированный TypeScript SDK для API Точка Банка",
  "type": "module",
  "license": "MIT",
  "author": "ONREZA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONREZA/tochka-sdk-ts.git",
    "directory": "packages/tochka-sdk"
  },
  "keywords": [
    "tochka",
    "tochka-bank",
    "sbp",
    "open-banking",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./pay-gateway": {
      "import": {
        "types": "./dist/pay-gateway.d.ts",
        "default": "./dist/pay-gateway.js"
      },
      "require": {
        "types": "./dist/pay-gateway.d.cts",
        "default": "./dist/pay-gateway.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "bun ../../tools/package-files.ts prepare && bun run build",
    "postpack": "bun ../../tools/package-files.ts clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:portable": "tsc --noEmit -p tsconfig.portable.json"
  },
  "dependencies": {
    "jose": "6.2.4",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/bun": "1.3.14",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
